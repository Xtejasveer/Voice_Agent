# Copy this file to .env and fill in the values. .env is gitignored.
#
# This project uses LiveKit Inference (Option A): STT/LLM/TTS are reached
# through LiveKit Cloud, so there are NO separate Deepgram/OpenAI/Cartesia
# keys. You only need your LiveKit Cloud project credentials below.

# LiveKit Cloud project (Settings -> Keys in the dashboard)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Inference model strings (swappable; PRD §4). Under the hood these are
# Deepgram (STT), OpenAI gpt-4o-mini (LLM), and Cartesia (TTS).
LLM_MODEL=openai/gpt-4o-mini
STT_MODEL=deepgram/flux-general
TTS_MODEL=cartesia/sonic-3
# Optional Cartesia voice id; leave blank for the model default.
TTS_VOICE=

# Agent name (used by the dev runner and the Agent Console).
AGENT_NAME=voice-agent

# Which seeded customer the demo call is about.
CUSTOMER_ID=CUST-001
