# Copy this file to .env and fill in the values. .env is gitignored.
# Phase 1 does not require any of these; they are used from Phase 2 onward.

# LiveKit (Phase 2)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech + LLM providers (Phase 2)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# LLM model id (swappable). Default: gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# Which seeded customer the demo call is about
CUSTOMER_ID=CUST-001
